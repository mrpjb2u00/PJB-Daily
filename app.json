{
  "expo": {
    "name": "To-Dos & Notes by PJBStudios",
    "slug": "todos-and-notes-by-pjb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "todosandnotes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pjbstudios.todosandnotes"
    },
    "android": {
      "package": "com.pjbstudios.todosandnotes",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "extra": {
      "eas": {
        "projectId": "9f5ecc15-c74b-4aa9-86d8-b850ce80fbf8"
      }
    }
  },
  "web": {
    "favicon": "./assets/images/favicon.png"
  },
  "plugins": [
    [
      "expo-router",
      {
        "origin": "https://replit.com/"
      }
    ],
    "expo-font",
    "expo-web-browser"
  ],
  "experiments": {
    "typedRoutes": true,
    "reactCompiler": true
  }
}
